   <text>
      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl>
                  <ptr target="bm:MgWebsite"/>
                  <citedRange>0579</citedRange>
               </bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለፀንሠትከ፡ በዘርዓ፡ ወላዲ፡ ልምላሜ።</l>
                  <l n="2">ወእምነ፡ እሙ፡ ገራህት፡ ለልደትከ፡ ሰላሜ።</l>
                  <l n="3">ንስሐ፡ ያዕቆብ፡ ኤፍሬም፡ ነጠብጣበ፡ ድንግል፡ ጊሜ፡</l>
                  <l n="4">ሰላመከ፡ ዘአኃዝክዎ፡ እስከ፡ እፌጽም፡ ፍጻሜ፡</l>
                  <l n="5">ምስለ፡ መንፈስ፡ ቅዱስ፡ ጽንሐኒ፡ ዘመነ፡ ወዕድሜ።</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እንዘ፡ ፬ ፩</l>
                  <l n="2">ወእንዘ፡ ፩፡ በስም፡ ከመ፡ ዮሐንስ፡ ፍቅዱ።</l>
                  <l n="3">ነፋሰ፡ <space reason="rubrication" unit="chars" quantity="3"/> ኤፍሬም፡ ለባሕረ፡ ውዳሴ፡ ሞገዱ፡</l>
                  <l n="4">መንገሌየ፡ በተማልዖ፡ እምነ፡ ወሰንከ፡ እዱ።</l>
                  <l n="5">ወድርሳናተ፡ ፻፼ ቅድሜየ፡ ይስግዱ።</l>
               </lg>
               <lg type="stanza" n="46">
                  <l n="1">
                     <supplied resp="AD" reason="omitted">ሰላም፡</supplied> ለፍልሰተ፡ ሥጋከ፡ ለወርኃ፡ የክቲት፡ አመ፡ ሠሉሱ</l>
                  <l n="2">እምነ፡ መቃብር፡ ባስልዮስ፡ እንተ፡ ቀደሳ፡ በነፍሱ፡</l>
                  <l n="3">ፍቁረ፡ ድንግል፡ ኤ፡ አብአኒ፡ ቤተ፡ ኢያሱ፡</l>
                  <l n="4">በአትከ፡ ዘቤተ፡ እብሎይ፡ መቅደሱ</l>
                  <l n="5">ለለዓውደ፡ ዓመት፡ ወወርህ፡ ላዕሌየ፡ ያንሶሱ፤</l>
               </lg>
               <lg type="stanza" n="47">
                  <l n="1">ድርሳናተ፡ ሰላም፡ ለከ ፍዳ፡ አቅረብኩ፡</l>
                  <l n="2">መጠነ፡ ፵ወስብእ፡ ስመ፡ <space reason="rubrication" unit="chars" quantity="2"/> ዘቦ፡</l>
                  <l n="3">ስቁለ፡ ጥሪት፡ ኤ፡ በኢየሩሳሌም፡ ፀልቦ።</l>
                  <l n="4">ሀበኒ፡ አስበ፡ ጻማየ፡ ወኢትበለኒ፡ አልቦ፡</l>
                  <l n="5">እስመ፡ ለዘከማየ፡ ሰብእ፡ ይሁብዎ፡ አስቦ፨</l>
               </lg>
            </div>
         </div>
