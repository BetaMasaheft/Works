   <text>
      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl>
                  <ptr target="bm:MgWebsite"/>
                  <citedRange>0581</citedRange>
               </bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ውስተ፡ አፈ፡ ዓለም፡ ዘመልኦ፨</l>
                  <l n="2">ኢየሱስ፡ ክርስቶስ፡ ዘፈጸመ፡ ሕገ፡ ተሰብኦ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ጸባኢ፡ ለጸባኢየ፡ ትጽብኦ፨</l>
                  <l n="4">ደብረ፡ ሊባኖስ፡ ትጼውዐከ፡ ጸውዖ፨</l>
                  <l n="5">እንዘ፡ ትልብ፡ ነዓ፡ እግዚኦ፡ እግዚኦ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ ወለርእስከ፡ ዘተላጸቀ፨</l>
                  <l n="2">እንዘ፡ ኢይትፈለጥ፡ ሕቀ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ጸሊ፡ ኀበ፡ ረሰይከ፡ ምርፋቀ፨</l>
                  <l n="4">ኢይሑር፡ አነ፡ ፍና፡ ርሑቀ፨</l>
                  <l n="5">ቅድመ፡ ለነፍስየ፡ አስተዳሉ፡ ስንቀ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለገጽከ፡ ለሙሴ፡ አምሳሉ፨</l>
                  <l n="2">ጽልሙታነ፡ ሕዝብ፡ ዘአብርሃ፡ በመዋዕሉ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ሰአሊ፡ ጳውሎስ፡ መምህረ፡ ኵሉ፨</l>
                  <l n="4">ከመ፡ ይብጽሐኒ፡ ወይርከበኒ፡ ሣህሉ፨</l>
                  <l n="5">ሰአሎ፡ ለአምላክከ፡ ዘሀሎ፡ ወይሄሉ፨</l>
               </lg>
               <lg type="stanza" n="4">
                  <l n="1">ሰላም፡ ለቀራንብቲከ፡ ቀራንብተ፡ ክርስቶስ፡ ሥሉጥ፨</l>
                  <l n="2">እንተ፡ አልቦቱ፡ ተውላጥ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> አጋቶን፡ ዘሀገረ፡ ተስፋ፡ መርዩጥ፨</l>
                  <l n="4">ተራድአኒ፡ ለወልድከ፡ ጊዜ፡ ጸብአ፡ ሰይጣን፡ ስሑት፨</l>
                  <l n="5">አርአያ፡ ረድኦ፡ አብርሃም፡ ለሎጥ፨</l>
               </lg>
               <lg type="stanza" n="8">
                  <l n="1">ሰላም፡ ለእስትንፋስከ፡ ዘመዐዛሁ፡ ስኂን፨</l>
                  <l n="2">ወለጕርዔከ፡ መዓርዒር፡ ኅሩመ፡ ስቴ፡ ሜስ፡ ወወይን፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ስጥጥ፡ መጽሐፈ፡ ፀርየ፡ ሰይጣን፨</l>
                  <l n="4">በከመ፡ ሰጠጠ፡ ጦማረ፡ ሮማዊ፡ ልዮን፨</l>
                  <l n="5">ዲዮስቆሮስ፡ ያርብሐዊ፡ በኵሉ፡ ዘመን፨</l>
               </lg>
               <lg type="stanza" n="21">
                  <l n="1">ሰላም፡ እብል፡ ለአፃብዐ፡ እግርከ፡ ሰንሰሪቍ፨</l>
                  <l n="2">እለ፡ ተኣምረ፡ ገብራ፡ በዘዚአሆን፡ ኍልቍ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ፀሓይ፡ ዘወርኀ፡ ኵርያቍ፨</l>
                  <l n="4">ስደኒ፡ ውስተ፡ ቤትከ፡ ዘአረፋቲሃ፡ አዕናቍ፨</l>
                  <l n="5">አኮ፡ ዘዕብን፡ ወአኮ፡ ዘኅቍ፨</l>
               </lg>
               <lg type="stanza" n="23">
                  <l n="1">ሰላም፡ ለቆምከ፡ ወለመልክእከ፡ ኅቱም፨</l>
                  <l n="2">በማኅተመ፡ አምላክ፡ ግሩም፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> አንበሳ፡ ዘደብረ፡ ሊባኖስ፡ ገዳም፨</l>
                  <l n="4">ተንሥእ፡ እምኅዝአትከ፡ ዘአልቦ፡ ድካም፨</l>
                  <l n="5">ማእረረከ፡ ኢታማስን፡ ላህም፨</l>
               </lg>
               <lg type="stanza" n="26">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ ለቤተ፡ ክርስቲያን፡ በፍጽማ፨</l>
                  <l n="2">እንተ፡ ይእቲ፡ ማኅደረ፡ ማርያም፡ ስማ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ካህን፡ ወነቢይ፡ ዘአውቴዝራማ፨</l>
                  <l n="4">ደቂቀ፡ ዚአከ፡ ከመ፡ ኢይሁክ፡ መስቴማ፨</l>
                  <l n="5">ኀይለከ፡ አንሥእ፡ ወአስተርኢ፡ ግርማ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ መቃብረ፡ ክርስቶስ፡ ዋሕድ፨</l>
                  <l n="2">ወመንፈስ፡ ቅዱስ፡ ማኅፈድ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ቀዋሚ፡ ካልአ፡ ስምዖን፡ ዘዐምድ፨</l>
                  <l n="4">ተበፃዕከ፡ ነዋ፡ በመርኅበ፡ ንጉሥ፡ ዐውድ፨</l>
                  <l n="5">ወተሰባሕከ፡ በኵሉ፡ ዐጸድ፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">ሰላም፡ ለአዕፅምቲከ፡ አዕፅምተ፡ ብእሲ፡ አዳም፨</l>
                  <l n="2">ዘኢየሩሳሌም፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ግሑሥ፡ ዘንብረትከ፡ ገዳም፨</l>
                  <l n="4">እምብዕለ፡ ነፍስከ፡ ክፍለኒ፡ ዮም፨</l>
                  <l n="5">እስመ፡ ብዕልየ፡ ጽላሎት፡ ወሕልም፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">
                     <space reason="rubrication" unit="chars" quantity="3"/> ብፁዕ፡ ዘቀነተ፡ ሰይፈ፨</l>
                  <l n="2">ውስተ፡ ቀርያታርም፡ ናባል፡ አመ፡ ኪያሁ፡ ፀረፈ፨</l>
                  <l n="3">ከመ፡ አዕረፎ፡ በሠናይ፡ ወነፍሰ፡ ዚአሁ፡ ተወክፈ፨</l>
                  <l n="4">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> እግዚእከ፡ ዘአናቅጸ፡ ሞት፡ ኀለፈ፨</l>
                  <l n="5">በርስዓን፡ ጥሉል፡ ኪያከ፡ አዕረፈ፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">ተኣምሪከ፡ ተከሥተ፡ እምተኀብኦቱ፡ ጥዩቀ፨</l>
                  <l n="2">እግዚአብሔር፡ አምላክ፡ እንተ፡ በይሁዳ፡ ተዐውቀ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ዮሐንስ፡ እንዘ፡ ኢተኀሥሥ፡ አውቀ፨</l>
                  <l n="4">በደሴተ፡ ባሕር፡ አመ፡ ረሰይከ፡ ምርፋቀ፨</l>
                  <l n="5">ሰይጣን፡ ጐየ፡ ወቆመ፡ ርኁቀ፨</l>
               </lg>
               <lg type="stanza" n="31">
                  <l n="1">ተአምሪከ፡ ሕፃን፡ እምከርሠ፡ መቃብር፡ ተወልደ፨</l>
                  <l n="2">ወአስተርአየ፡ ገሀደ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ለክርስቶስ፡ እንዘ፡ ታቄርብ፡ ሰጊደ፨</l>
                  <l n="4">በደሴተ፡ ባሕር፡ አምጣነ፡ ኮንከ፡ ጽሙደ፨</l>
                  <l n="5">ኀቤከ፡ ውእቱ፡ እምሰማይ፡ ወረደ፨</l>
               </lg>
               <lg type="stanza" n="32">
                  <l n="1">
                     <space reason="rubrication" unit="chars" quantity="3"/> ንጉሥ፡ እንዘ፡ የኀልፍ፡ ፍኖተ፨</l>
                  <l n="2">ሳሚ፡ ረጋሚ፡ ረገመ፡ ርግምተ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> ኪያከ፡ እመ፡ ጸአለ፡ ጽእለተ፨</l>
                  <l n="4">ብእሲ፡ በሥጋሁ፡ ይረክብ፡ ቍረተ፨</l>
                  <l n="5">ወበነፍሱ፡ ይትዋረስ፡ እሳተ፨</l>
               </lg>
               <lg type="stanza" n="33">
                  <l n="1">አምጣነ፡ አቅረብኩ፡ ለከ፡ አምኃ፡ ሰላምየ፡ ዘንተ፨</l>
                  <l n="2">በከመ፡ ተክህለኒ፡ ሊተ፨</l>
                  <l n="3">
                     <supplied resp="AD" reason="omitted">ተክለ፡ ሃይማኖት፡</supplied> አቡየ፡ እስመ፡ መምህረ፡ ሕግ፡ አንተ፨</l>
                  <l n="4">በዝዓለም፡ ሀበኒ፡ በረከተ፨</l>
                  <l n="5">ወበደኃሪ፡ ንሥአኒ፡ ዐሥራተ፨</l>
               </lg>
            </div>
